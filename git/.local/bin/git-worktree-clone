#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "usage: git worktree-clone <remote-url> [directory]" >&2
    exit 2
fi

remote_url=$1
directory=${2:-}

if [ -z "$directory" ]; then
    directory=${remote_url%/}
    directory=${directory##*/}
    directory=${directory%.git}
fi

if [ -z "$directory" ]; then
    echo "error: could not derive a directory from $remote_url" >&2
    exit 1
fi

if [ -e "$directory" ] && [ ! -d "$directory" ]; then
    echo "error: $directory is not a directory" >&2
    exit 1
fi

if [ -d "$directory" ] && [ -n "$(find "$directory" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    echo "error: $directory is not empty" >&2
    exit 1
fi

mkdir -p "$directory"
git clone --bare "$remote_url" "$directory/.bare"
echo 'gitdir: ./.bare' > "$directory/.git"

git -C "$directory" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
git -C "$directory" config core.logAllRefUpdates true
git -C "$directory" config worktree.useRelativePaths true
git -C "$directory" fetch --prune origin
git -C "$directory" remote set-head origin --auto

default_ref=$(git -C "$directory" symbolic-ref --quiet --short refs/remotes/origin/HEAD || true)
case "$default_ref" in
    origin/*) default_branch=${default_ref#origin/} ;;
    *)
        echo "error: could not determine origin's default branch" >&2
        exit 1
        ;;
esac

if git -C "$directory" show-ref --verify --quiet "refs/heads/$default_branch"; then
    git -C "$directory" worktree add "$default_branch" "$default_branch"
else
    git -C "$directory" worktree add -b "$default_branch" "$default_branch" "origin/$default_branch"
fi
git -C "$directory/$default_branch" branch --set-upstream-to="origin/$default_branch" "$default_branch"
