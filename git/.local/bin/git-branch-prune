#!/bin/bash

# Auto-detect main branch
MAIN_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')

if [ -z "$MAIN_BRANCH" ]; then
    echo "❌ Could not detect main branch. Is origin set up?"
    exit 1
fi

echo "✅ Using '$MAIN_BRANCH' as the base branch."

declare -A worktree_branches=()

while IFS= read -r branch; do
    worktree_branches["$branch"]=1
done < <(git worktree list --porcelain | sed -n 's/^branch refs\/heads\///p')

while IFS= read -r branch; do
    if [[ "$branch" == "$MAIN_BRANCH" ]]; then
        continue
    fi

    if [[ -n "${worktree_branches[$branch]}" ]]; then
        echo "⚠️ Skipping $branch because it is checked out in a worktree."
        continue
    fi

    # Get the diff between the branch and main
    base=$(git merge-base "$MAIN_BRANCH" "$branch")
    # Make a syntetic commit with the tree of the branch and parent of the branch, simulating a squash merge, and check if there are any changes compared to main
    synthetic_commit=$(git commit-tree "$(git rev-parse "$branch^{tree}")" -p "$base" -m _)
    if [[ $(git cherry "$MAIN_BRANCH" "$synthetic_commit") == "-"* ]]; then
        if [[ "$1" = "-f" || "$(read -rp "Delete $branch (squash merged into $MAIN_BRANCH)? [y/N] " confirm && echo "$confirm")" =~ ^[Yy]$ ]]; then
            echo "🗑️ Deleting $branch"
            git branch -D "$branch" > /dev/null
        else
            echo "❌ Skipped $branch"
        fi
    fi
done < <(git for-each-ref --format='%(refname:short)' refs/heads/)
