#!/usr/bin/env bash
set -euo pipefail

configure_bare_repo() {
    git --git-dir=.bare config core.bare true
    git --git-dir=.bare config core.logAllRefUpdates true
    git --git-dir=.bare config worktree.useRelativePaths true
}

resolve_source_dir() {
    if [[ -d $repository/.bare ]]; then
        source_dir=$repository
    else
        source_dir=$(git -C "$repository" rev-parse --show-toplevel)
    fi

    cd -P "$source_dir"
    source_dir=$PWD
}

handle_existing_bare_repo() {
    [[ -d .bare ]] || return 0

    if [[ -e .git ]]; then
        if [[ -f .git && $(<.git) == 'gitdir: ./.bare' ]]; then
            configure_bare_repo
            echo "migration already complete"
            exit 0
        fi

        echo "error: .git exists but does not point to .bare" >&2
        exit 1
    fi

    if [[ $(git --git-dir=.bare rev-parse --is-bare-repository) != true ]]; then
        echo "error: .bare is not a bare Git repository" >&2
        exit 1
    fi

    echo 'gitdir: ./.bare' > .git
    configure_bare_repo
    exit 0
}

validate_source_repo() {
    if [[ ! -d .git ]]; then
        echo "error: source repository must use a .git directory" >&2
        exit 1
    fi

    branch=$(git branch --show-current)
    if [[ -z $branch ]]; then
        echo "error: source repository is in detached HEAD state" >&2
        exit 1
    fi

    if [[ -n $(git submodule status) ]]; then
        echo "error: source repository contains submodules" >&2
        exit 1
    fi
}

collect_linked_worktrees() {
    linked_worktrees=()
    while read -r worktree; do
        [[ $worktree == "$source_dir" ]] && continue

        if [[ ! -e $worktree ]]; then
            echo "error: linked worktree does not exist: $worktree" >&2
            exit 1
        fi

        linked_worktrees+=("$worktree")
    done < <(
        git worktree list --porcelain |
            awk '/^worktree / { print substr($0, 10) }' |
            sort -r
    )
}

stage_linked_worktrees() {
    local temporary_dir=$1

    mkdir "$temporary_dir/worktrees"
    for index in "${!linked_worktrees[@]}"; do
        mv "${linked_worktrees[$index]}" "$temporary_dir/worktrees/$index"
    done
}

migrate_current_checkout() {
    local temporary_dir=$1

    mv "$source_dir" "$temporary_dir/current"
    mkdir "$source_dir"
    mv "$temporary_dir/current/.git" "$source_dir/.bare"
    echo 'gitdir: ./.bare' > "$source_dir/.git"
    cd "$source_dir"
    configure_bare_repo

    current=${branch##*/}
    git worktree add --no-checkout "$current" "$branch"
    mv "$current/.git" "$temporary_dir/current.git"
    rmdir "$current"
    mv "$temporary_dir/current" "$current"
    mv "$temporary_dir/current.git" "$current/.git"
    cp .bare/index "$(git -C "$current" rev-parse --absolute-git-dir)/index"
}

restore_linked_worktrees() {
    local temporary_dir=$1

    if (( ${#linked_worktrees[@]} == 0 )); then
        return 0
    fi

    restored_worktrees=()
    for index in "${!linked_worktrees[@]}"; do
        worktree=${linked_worktrees[$index]}
        destination=$source_dir/${worktree##*/}
        if [[ -e $destination ]]; then
            echo "error: destination already exists: $destination" >&2
            exit 1
        fi
        mv "$temporary_dir/worktrees/$index" "$destination"
        restored_worktrees+=("$destination")
    done

    git worktree repair "${restored_worktrees[@]}"
}

if (( $# > 1 )); then
    echo "usage: git worktree-migrate [repository]" >&2
    exit 2
fi

repository=${1:-.}
resolve_source_dir
handle_existing_bare_repo
validate_source_repo
collect_linked_worktrees
temporary_dir="$source_dir.worktree-migrate.$$"
mkdir "$temporary_dir"
stage_linked_worktrees "$temporary_dir"
migrate_current_checkout "$temporary_dir"
restore_linked_worktrees "$temporary_dir"
rm -rf "$temporary_dir"
