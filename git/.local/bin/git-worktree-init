#!/bin/sh
set -eu

if [ "$#" -gt 1 ]; then
    echo "usage: git worktree-init [directory]" >&2
    exit 2
fi

directory=${1:-.}

if [ -e "$directory" ] && [ ! -d "$directory" ]; then
    echo "error: $directory is not a directory" >&2
    exit 1
fi

if [ -d "$directory" ] && [ -n "$(find "$directory" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    echo "error: $directory is not empty" >&2
    exit 1
fi

mkdir -p "$directory"
git init --bare "$directory/.bare"
echo 'gitdir: ./.bare' > "$directory/.git"

git -C "$directory" config core.logAllRefUpdates true
git -C "$directory" config worktree.useRelativePaths true
